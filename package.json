{
  "name": "stayilo-free",
  "version": "1.0.1",
  "private": true,
  "description": "Uncompiled source for the Stayilo free WordPress plugin. The portal template included here is Classic.",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:free": "npm run start -w @stayilo/free-core",
    "dev:free-setup": "npm run start -w @stayilo/free-core -- --open /setup.html",
    "dev:portal-free": "npm run start -w @stayilo/portal-shell",
    "watch:free": "npm run start:wp -w @stayilo/free-core",
    "watch:portal-free": "npm run start:wp -w @stayilo/portal-shell",
    "build:free": "npm run build -w @stayilo/free-core",
    "build:portal-free": "npm run build -w @stayilo/portal-shell",
    "build": "npm run build:free && npm run build:portal-free"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "6.30.4",
    "react-router-dom": "6.30.4"
  }
}
